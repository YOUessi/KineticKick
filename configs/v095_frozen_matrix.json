    {
      "case": "gpu_separated_on",
      "device": "cuda:0",
      "report_mode": "on",
      "capture": "tensor",
      "layout": "separated",
      "subscribe_phase": "pre_reset"
    }
  ],
  "strict_acceptance": {
    "tensor_positive_cuda_min": 1,
    "negative_separated_tensor_must_be_zero": true,
    "off_on_state_exactly_equal": true,
    "native_collider_truth_requires": [
