  "purpose": "Independent 200Hz native report timing vs calibrated CUDA tensor positive/negative; historical G1 safety analysis and executable offline fullbody generation; original motors forbidden",
  "steps": 180,
  "timeout_s": 135,
  "required_free_gib": 20,
