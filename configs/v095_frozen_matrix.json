  "physical_G1_actuation_new": false,
  "matrix": [
    {
      "case": "cpu_pose_off",
      "device": "cpu",
      "report_mode": "off",
      "capture": "pose",
      "layout": "colliding",
      "subscribe_phase": "pre_reset"
    },
    {
      "case": "cpu_native_on",
      "device": "cpu",
      "report_mode": "on",
      "capture": "native",
      "layout": "colliding",
      "subscribe_phase": "pre_reset"
    },
    {
      "case": "cpu_native_after_on",
      "device": "cpu",
      "report_mode": "on",
      "capture": "native",
      "layout": "colliding",
      "subscribe_phase": "post_reset"
    },
    {
      "case": "gpu_pose_off",
      "device": "cuda:0",
      "report_mode": "off",
      "capture": "pose",
      "layout": "colliding",
      "subscribe_phase": "pre_reset"
    },
    {
      "case": "gpu_native_on",
      "device": "cuda:0",
      "report_mode": "on",
      "capture": "native",
      "layout": "colliding",
      "subscribe_phase": "pre_reset"
    },
    {
      "case": "gpu_native_after_on",
      "device": "cuda:0",
      "report_mode": "on",
      "capture": "native",
      "layout": "colliding",
      "subscribe_phase": "post_reset"
    },
    {
      "case": "gpu_tensor_on",
      "device": "cuda:0",
      "report_mode": "on",
      "capture": "tensor",
      "layout": "colliding",
      "subscribe_phase": "pre_reset"
    },
    {
      "case": "gpu_both_on",
      "device": "cuda:0",
      "report_mode": "on",
      "capture": "both",
      "layout": "colliding",
      "subscribe_phase": "pre_reset"
